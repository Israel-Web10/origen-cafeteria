# Variables de PRODUCCIÓN (copiar como deploy/.env y completar). Nunca subir el archivo real al repositorio.
NODE_ENV=production
PORT=4000
# Dominio real del sitio (CORS). Si frontend y API comparten dominio, el mismo valor.
CLIENT_URL=https://www.tu-dominio.com
TRUST_PROXY=1

DB_NAME=origen_cafeteria
DB_USER=origen_app
DB_PASSWORD=
# En un servicio administrado en la nube usa DATABASE_URL y DB_SSL=verify-full (o require)
# DATABASE_URL=
DB_SSL=disable

# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
LOG_LEVEL=info

# Almacenamiento: local (VPS con disco persistente) o s3 (R2/B2/S3; necesario en PaaS con disco efímero)
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=origen-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.tu-dominio.com

# Tarjeta: en producción solo "none" hasta contratar e integrar un proveedor real
CARD_PROVIDER=none

# --- Escalabilidad (ver docs/ESCALABILIDAD.md) ---
# Procesos de Node (1 por núcleo de CPU). Conexiones a la BD = WEB_CONCURRENCY × DB_POOL_MAX (< max_connections).
WEB_CONCURRENCY=1
# Micro-caché de la carta/configuración pública en milisegundos (0 = desactivada)
PUBLIC_CACHE_TTL_MS=10000
# Peticiones por minuto y por IP a la API en general (las redes móviles comparten IP: no bajar demasiado)
RATE_LIMIT_GENERAL_PER_MIN=300

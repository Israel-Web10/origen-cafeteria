# ============================================================
# ORIGEN — Variables del frontend (se incrustan al compilar: NO pongas secretos aquí)
# ============================================================

# URL de la API. Por defecto "/api/v1" (mismo dominio; en desarrollo Vite la reenvía al backend).
# Úsala solo si la API está en otro dominio, p. ej.:
# VITE_API_URL=https://api.tu-dominio.com/api/v1

# En desarrollo, a dónde reenviar /api y /uploads (por defecto http://localhost:4000)
# VITE_DEV_BACKEND=http://localhost:4000

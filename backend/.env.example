# ============================================================
# ORIGEN — Variables de entorno del backend
# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env real a un repositorio.
# ============================================================

NODE_ENV=development
PORT=4000
# Orígenes permitidos para CORS (separados por coma). En producción: https://tu-dominio.com
CLIENT_URL=http://localhost:5173
# Si la API está detrás de un proxy/balanceador (Nginx, Render, Railway...), número de saltos a confiar
TRUST_PROXY=0

# --- PostgreSQL ---
# Opción A: una URL completa (habitual en servicios administrados)
# DATABASE_URL=postgres://usuario:contraseña@host:5432/origen_cafeteria
# Opción B: parámetros separados
DB_HOST=localhost
DB_PORT=5432
DB_USER=origen_app
DB_PASSWORD=cambia_esta_contraseña
DB_NAME=origen_cafeteria
# disable (local) | require (nube, cifrado) | verify-full (nube, cifrado + verificación de certificado)
DB_SSL=disable
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# --- Escalabilidad (ver docs/ESCALABILIDAD.md) ---
# Procesos de Node (1 por núcleo de CPU). Conexiones a la BD = WEB_CONCURRENCY × DB_POOL_MAX (< max_connections).
WEB_CONCURRENCY=1
# Micro-caché de la carta/configuración pública en milisegundos (0 = desactivada)
PUBLIC_CACHE_TTL_MS=10000
# Peticiones por minuto y por IP a la API en general (las redes móviles comparten IP: no bajar demasiado)
RATE_LIMIT_GENERAL_PER_MIN=300

# --- Autenticación ---
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Archivos subidos ---
# En producción usa un disco/volumen PERSISTENTE (ver docs/DESPLIEGUE.md)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# --- Reportes ---
REPORT_MAX_ROWS=50000

LOG_LEVEL=info

# --- Pagos con tarjeta ---
# none = deshabilitado (por defecto). test = SIMULADOR de pruebas, prohibido en producción.
# No existe integración con un proveedor real: ver docs/investigacion/pagos-bolivia.md
CARD_PROVIDER=none

# --- Almacenamiento de imágenes y comprobantes ---
# local = disco del servidor (solo si es PERSISTENTE, p. ej. un VPS)
# s3    = Cloudflare R2 / Backblaze B2 / AWS S3 (necesario en plataformas con disco efímero)
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=origen-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Dominio público del bucket (solo se publica la carpeta public/; los comprobantes van en private/)
# S3_PUBLIC_BASE_URL=https://media.tu-dominio.com

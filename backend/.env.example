# ============================================================
# ORIGEN — Backend environment variables (DESARROLLO)
# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env real a un repositorio.
# ============================================================

# Servidor
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=origen_cafeteria

# Autenticación
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Subida de archivos (almacenamiento local en desarrollo)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ------------------------------------------------------------
# Servicios externos OPCIONALES (dejar vacío mientras no se usen)
# Ver docs/API.md sección "Servicios externos" para más detalle.
# ------------------------------------------------------------

# Almacenamiento de imágenes en la nube (recomendado para producción)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Pasarela de pagos con tarjeta (no se implementa una integración real)
# PAYMENT_GATEWAY_PUBLIC_KEY=
# PAYMENT_GATEWAY_SECRET_KEY=

# Facturación fiscal electrónica de Bolivia (no existe una API pública
# genérica; requiere contratar un proveedor autorizado de facturación
# electrónica y seguir la normativa del Servicio de Impuestos Nacionales)
# FISCAL_INVOICING_PROVIDER=
# FISCAL_INVOICING_API_KEY=

# Google Maps (para geocodificación en el backend, si se necesita)
# GOOGLE_MAPS_API_KEY=
